# Config/project.env.example — copy to Config/project.env, or generate it with
# ./Scripts/configure-project.sh (recommended: it validates as it writes).
#
# FORMAT CONTRACT
# This file is parsed, never sourced. Every line must be blank, a `#` comment,
# or exactly:
#     KEY="value"
# at column 0. Values are literal: a value may not contain " $ or ` and no
# shell expansion happens. Relative paths resolve against the repository root.
# Arguments lists are split on whitespace, so an individual argument cannot
# contain a space.
#
# There is NO escape for " $ or `. That is the point: if a value could smuggle a
# dollar sign past the parser, loading a configuration could execute code. A
# product name containing one of those characters cannot be expressed here — put
# the display name in the Xcode project and leave PROJECT_NAME to the plain form.
# ./Scripts/configure-project.sh validates before it writes, so a rejected value
# leaves your existing configuration untouched.
#
# A key must be present at most once, and only the keys documented below are
# accepted. An empty value is a real value, not an absent one: TEMPLATE_REPOSITORY=""
# is rejected rather than treated as "false".
#
# COMMITTED, NOT SECRET
# Config/project.env is committed on purpose — it is what makes a build
# reproducible on another machine. Never put credentials, tokens, API keys, or
# signing material in it. Record privacy and permission decisions in
# AI/ARCHITECTURE.md and AI/DESIGN.md.

# --- Identity ---------------------------------------------------------------

# iOS or watchOS (modern Watch-only app); absent means iOS for older configs.
# An explicitly empty value is invalid. No iPhone companion is supported in watchOS mode.
APP_PLATFORM="iOS"

# Human-readable product name. Used only in reports.
PROJECT_NAME=""

# The application bundle identifier, for release auditing.
# Example: BUNDLE_IDENTIFIER="com.example.yourapp"
BUNDLE_IDENTIFIER=""

# --- Project container: set EXACTLY ONE of the next two --------------------
#
# PROJECT_PATH and WORKSPACE_PATH are mutually exclusive. Setting both is a
# configuration error (exit 64); setting neither leaves the repository with
# nothing to build (exit 69, unless TEMPLATE_REPOSITORY="true").
#
# Use PROJECT_PATH for a plain Xcode project:
#     PROJECT_PATH="App/YourApp.xcodeproj"
# Use WORKSPACE_PATH when a workspace is what Xcode opens — for example when
# several projects share one workspace:
#     WORKSPACE_PATH="App/YourApp.xcworkspace"
#
# Third-party code comes from Swift Package Manager: the project references the
# packages, Xcode resolves them into DerivedData, and the committed Package.resolved
# under xcshareddata/swiftpm/ pins them, so a candidate snapshot rebuilds what was
# verified. A CocoaPods Pods/ or a Carthage tree under App/ cannot be verified here:
# it is ignored, so the clean-HEAD gates refuse it as an ignored build input, and a
# candidate snapshot never contains it.

PROJECT_PATH=""
WORKSPACE_PATH=""

# The shared scheme every gate builds and tests. It must be marked "Shared" in
# Xcode (Product > Scheme > Manage Schemes) or xcodebuild will not see it.
SCHEME=""

# Optional. Names the single application target when the scheme contains more
# than one (for example an app plus an app clip or extension). Only needed if
# MARKETING_VERSION / CURRENT_PROJECT_VERSION cannot be resolved unambiguously
# during release verification.
# For watchOS, name the executable Watch app, never its packaging container.
APP_TARGET=""

# --- Build configurations ---------------------------------------------------

CONFIGURATION_DEBUG="Debug"
CONFIGURATION_RELEASE="Release"

# These must name distinct configurations. Fast and milestone verification build
# the development configuration, and integration builds it for the merged
# candidate; release additionally builds the shipping configuration, for a generic
# device of APP_PLATFORM with code signing disabled, since signing belongs to
# the manual Archive. An ordinary push runs no application verification at all. Setting both
# keys to the same value is a configuration error.

# --- Destinations -----------------------------------------------------------
#
# No simulator is hard-coded anywhere in this template. Pick destinations that
# match the deployment target recorded in AI/ARCHITECTURE.md, and prefer a
# pinned simulator id for gates so results are reproducible.
#
# List what this machine actually has:
#     xcrun simctl list devices available
#
# Examples only — replace them:
#     BUILD_DESTINATION="platform=iOS Simulator,name=iPhone 17 Pro"
#     BUILD_DESTINATION="platform=iOS Simulator,name=iPhone 17,OS=26.5"
#     BUILD_DESTINATION="platform=iOS Simulator,id=00000000-0000-0000-0000-000000000000"
#     BUILD_DESTINATION="generic/platform=iOS Simulator"
#     TEST_DESTINATION="platform=iOS Simulator,id=00000000-0000-0000-0000-000000000000"
#     TEST_DESTINATION="platform=watchOS Simulator,id=00000000-0000-0000-0000-000000000000"

BUILD_DESTINATION=""
TEST_DESTINATION=""

# The universal template has no device. New product configuration defaults to
# managed; configuration files without this key retain explicit destinations.
# Pin identifiers from xcrun simctl list -j; setup never downloads runtimes.
# Runtime platform must match APP_PLATFORM, and its supportedDeviceTypes must
# include SIMULATOR_DEVICE_TYPE. Watch-only uses one Watch simulator, no pairing.
# In managed mode destinations above are replaced with the local device UDID.
SIMULATOR_MODE="explicit"
SIMULATOR_DEVICE_TYPE=""
SIMULATOR_RUNTIME=""

# --- Test scope -------------------------------------------------------------
#
# These are EXTRA xcodebuild arguments, not a replacement for the suite.
#
# FAST_TEST_ARGUMENTS      the quick development loop (./Scripts/verify-fast.sh).
#                          Narrow it freely — this gate is for feedback speed.
#                          Example: FAST_TEST_ARGUMENTS="-only-testing:YourAppTests"
#
# MILESTONE_TEST_ARGUMENTS milestone verification. Empty means every test in
#                          the scheme, which is the default and the recommended
#                          setting. If narrowed, the milestone file must bind
#                          itself to the exact value and carry a machine-read
#                          Test scope rationale; see the milestone template.
#
#                          That covers arguments changing WHICH tests run.
#                          Arguments that retry or repeat a failing test —
#                          -retry-tests-on-failure, -test-iterations,
#                          -run-tests-until-failure — are refused (exit 64) by
#                          `make static` and by the milestone gate: a retried
#                          flake reports failed=0, and the milestone report's
#                          counts are supposed to describe the run. A test plan
#                          whose Test Repetition Mode is anything but None asks
#                          Xcode for the same retries, so `make static` refuses
#                          that committed setting too, for every gate.
#
# RELEASE_TEST_ARGUMENTS   release AND integration verification. These gates run the
#                          complete suite by design, so this setting is checked
#                          against a positive ALLOWLIST (exit 64 otherwise):
#                          only arguments that change HOW the suite runs are
#                          accepted — parallelism, timeouts, code coverage,
#                          package-resolution and verbosity flags.
#
#                          Everything able to change WHICH tests run is
#                          rejected, including -only-testing, -skip-testing,
#                          -testPlan, -only-test-configuration,
#                          -skip-test-configuration, -test-iterations and
#                          -retry-tests-on-failure. A blocklist that missed one
#                          of those would turn "the complete suite passed" into
#                          a false statement, so the check is an allowlist.
#
#                          Example: RELEASE_TEST_ARGUMENTS="-parallel-testing-enabled NO"
#
#                          PARALLEL TESTS. Test parallelism belongs to Xcode, and
#                          this is where a project reaches it: the allowlist
#                          accepts -parallel-testing-enabled,
#                          -parallel-testing-worker-count,
#                          -maximum-parallel-testing-workers and
#                          -maximum-concurrent-test-simulator-destinations. None
#                          of them changes which tests run, so none of them can
#                          make "the complete suite passed" untrue.
#
#                          Left empty, these gates run whatever the shared scheme
#                          and its test plans already say, which is the right
#                          default: the project's own scheme is the one place that
#                          knows which of its targets are safe to parallelize.
#
#                          Unit tests that share no mutable state are the ones to
#                          enable it for, and Xcode's per-target
#                          "Execute in parallel" setting is where to say so.
#
#                          Be conservative with UI tests. They share a simulator,
#                          app state, permission grants, the keychain,
#                          notifications and any external service the app talks
#                          to, so running two at once makes them fail for reasons
#                          that have nothing to do with the code. Parallelize them
#                          only once the suite is demonstrably isolated and Xcode
#                          can clone independent destinations for them; otherwise
#                          leave them serial. A test suite that is fast and
#                          flaky establishes nothing.
#
# The integration gate (./Scripts/verify-integration.sh) always runs the complete suite in
# the shared scheme, including UI tests. It applies no filter of its own and
# cannot be narrowed. If a project genuinely needs several test plans, the
# shared scheme's own plan set is what the gate runs — plan selection is not
# configurable here, because a gate that can be pointed at a smaller plan is
# not a complete-suite gate.

FAST_TEST_ARGUMENTS=""
MILESTONE_TEST_ARGUMENTS=""
RELEASE_TEST_ARGUMENTS=""

# --- Paths ------------------------------------------------------------------

# Leave empty to use the computed default:
#     /private/tmp/<repository-name>-<hash-of-worktree-path>/DerivedData
#
# The hash keys the cache to this specific checkout, so the parallel localization
# worktrees never share DerivedData and never interfere, while a single
# worktree keeps its cache between runs for fast incremental builds.
#
# A nonempty override must remain a strict child of the checkout-specific
# `/private/tmp/<repository-name>-<hash>/` root shown above and may not contain
# a symlink. Root, home, repository, parent, and broad temporary paths are
# rejected. Configuration never expands the set of directories the tooling
# owns, and cleanup never prints a recursive deletion command for an override.
#
# DerivedData is disposable build cache. Verification EVIDENCE (logs, .xcresult
# bundles, summaries, reports) always goes under .artifacts/ instead.
# `make clean-artifacts` never touches DerivedData; `make clean-derived-data`
# removes only this worktree's cache.
DERIVED_DATA_PATH=""

# --- Release policy ---------------------------------------------------------
#
# No key configures archiving. Release verification does not archive, upload,
# submit, or publish; those distribution operations use the selected signing
# context outside this repository.

# How this product reaches its users. Final audit coverage is filtered by this
# value, so an internal-only app is not evaluated against App Store deliverables
# it does not have, and an App Store app cannot omit them.
#
#   "app-store"  submitted to the App Store. The policy and support URLs, the age
#                rating, and the nutrition labels are all required.
#   "internal"   enterprise or ad-hoc internal distribution.
#
# There is no third value, and the default is the strict one.
DISTRIBUTION_CHANNEL="app-store"

# --- Published legal and support site ----------------------------------------
#
# Apple requires a working privacy policy URL and support URL for every App Store
# app, and Terms and Privacy links inside any app selling a subscription. Web/
# holds the site that serves them; these three values are what it is published
# from and checked against.
#
# SUPPORT_SITE_URL  the site's origin, https, with NO trailing slash and no path.
#                   The template appends the paths itself:
#                       <SUPPORT_SITE_URL>/privacy
#                       <SUPPORT_SITE_URL>/terms      (links to Apple's Standard EULA)
#                       <SUPPORT_SITE_URL>/support
#
#                   The FIRST LABEL of the host is also the Cloudflare Pages
#                   project name, which is why "https://yourapp.pages.dev"
#                   deploys to the project "yourapp". Deriving it rather than
#                   configuring it separately is what stops the URL you publish
#                   and the URL you ship in the app from drifting apart, so
#                   Cloudflare's rule applies here: alphanumerics and dashes only.
#
#                   Example: SUPPORT_SITE_URL="https://yourapp.pages.dev"
#
# SUPPORT_EMAIL     one plain address, shown on the privacy and support pages and
#                   reachable from inside the app. No display name, no second
#                   address. This mailbox receives real user mail, so treat it as
#                   a data flow and record it in AI/ARCHITECTURE.md.
#
# DEVELOPER_NAME    the person or company published as the developer. It appears
#                   in the site footer and in the privacy policy.
#
# Empty is legal until the Legal and Support milestone fills them in, and no gate
# ever demands them: a product may host its policy on a domain of its own and never
# publish Web/. A value that is SET is validated immediately, wherever it is read.
# What an App Store candidate owes is the working pages themselves, and the final
# audit enforces that: REL-503, REL-1004, and REL-1008 must be VERIFIED in the
# consolidated record before release verification can pass, and none of them may be
# recorded INAPPLICABLE. An internal build is never asked for them.

SUPPORT_SITE_URL=""
SUPPORT_EMAIL=""
DEVELOPER_NAME=""

# --- Repository mode --------------------------------------------------------
#
# "true"  only in the universal template repository, which has no application
#         target. Its integration gate runs every repository-level check — template
#         validation, static analysis, shell syntax, optional-hook definition, documentation
#         and configuration validation — and does not pretend to run xcodebuild.
#
# "false" every product repository. The integration gate additionally requires that
#         the app builds and the complete configured test suite passes.
#
# ./Scripts/configure-project.sh sets this to "false" automatically once a
# project or workspace is configured. "true" together with a configured project
# is a contradiction and fails verification (exit 65) rather than picking a mode
# silently.
TEMPLATE_REPOSITORY="false"

# --- Optional tooling -------------------------------------------------------
#
# Opt-in only. This template adds no linting dependency of its own.
# If a tool is enabled but not installed, verification FAILS with install
# instructions — a check that cannot run is not a check that passed. Nothing is
# ever installed automatically.

ENABLE_SWIFTLINT="false"
ENABLE_SWIFTFORMAT="false"
ENABLE_SHELLCHECK="false"

# Watch-only by default; companion mode adds a mandatory complete iOS profile.
WATCH_APP_MODE="watch-only"
COMPANION_PROFILE=""
