# Config/project.env — live configuration for THIS repository.
#
# This copy configures the universal template repository itself, which has no
# application target. Every product key is intentionally empty and
# TEMPLATE_REPOSITORY is "true", so the local gates run the repository-level
# checks and never pretend to run xcodebuild.
#
# After you copy this template and add your Xcode project, replace this file by
# running ./Scripts/configure-project.sh — it fills in the product keys and
# flips TEMPLATE_REPOSITORY to "false" for you.
#
# See Config/project.env.example for what every key means.
# This file is committed and must never contain credentials.

# iOS or watchOS (modern Watch-only app); absent means iOS for older configs.
# An explicitly empty value is invalid. No iPhone companion is supported in watchOS mode.
APP_PLATFORM="iOS"

PROJECT_NAME=""
BUNDLE_IDENTIFIER=""

PROJECT_PATH=""
WORKSPACE_PATH=""
SCHEME=""
APP_TARGET=""

CONFIGURATION_DEBUG="Debug"
CONFIGURATION_RELEASE="Release"

BUILD_DESTINATION=""
TEST_DESTINATION=""

# The universal template has no device. New product configuration defaults to
# managed; configuration files without this key retain explicit destinations.
# Pin identifiers from xcrun simctl list -j; setup never downloads runtimes.
# In managed mode destinations above are replaced with the local device UDID.
SIMULATOR_MODE="explicit"
SIMULATOR_DEVICE_TYPE=""
SIMULATOR_RUNTIME=""

FAST_TEST_ARGUMENTS=""
MILESTONE_TEST_ARGUMENTS=""
RELEASE_TEST_ARGUMENTS=""

DERIVED_DATA_PATH=""

DISTRIBUTION_CHANNEL="app-store"

SUPPORT_SITE_URL=""
SUPPORT_EMAIL=""
DEVELOPER_NAME=""

TEMPLATE_REPOSITORY="true"

ENABLE_SWIFTLINT="false"
ENABLE_SWIFTFORMAT="false"
ENABLE_SHELLCHECK="false"
