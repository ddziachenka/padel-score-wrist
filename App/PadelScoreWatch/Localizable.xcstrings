    "Your latest change couldn’t be read, so the game saved before it was restored.": {
      "comment": "Alert message at launch after restoring the previous save.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest change couldn’t be read, so the game saved before it was restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer tu último cambio. Se ha recuperado la partida guardada antes de ese cambio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima modifica era illeggibile, quindi è stata ripristinata la partita salvata in precedenza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière modification était illisible. La sauvegarde précédente de la partie a donc été rétablie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a última alteração, pelo que foi recuperada a versão da partida guardada antes dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a última alteração. A versão da partida salva antes dela foi restaurada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste wijziging kon niet worden gelezen. Daarom is de vorige opgeslagen versie van je wedstrijd hersteld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Änderung war nicht lesbar. Deshalb wurde der davor gespeicherte Stand wiederhergestellt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din senaste ändring kunde inte läsas. Därför återställdes spelet från sparningen före ändringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din seneste ændring kunne ikke læses, så den forrige gemte kamp blev gendannet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisintä muutosta ei voitu lukea, joten sitä edeltävä tallennettu peli palautettiin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den siste endringen kunne ikke leses. Spillet er derfor gjenopprettet fra forrige lagring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать последнее изменение. Восстановлена игра, сохранённая до него."
          }
        }
      }
    },
