    "Restore purchases uses your Apple Account. Refunding a purchase removes unlimited access; your saved game and result remain available.": {
      "comment": "Access and purchase: Restore purchases uses your Apple Account. Refunding a purchase removes unlimited access; your saved game and result remain available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore purchases uses your Apple Account. Refunding a purchase removes unlimited access; your saved game and result remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar compras usa tu cuenta de Apple. Un reembolso retira el acceso sin límite; tu partida y tu resultado guardados siguen disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina acquisti usa il tuo Apple Account. Il rimborso di un acquisto rimuove l’accesso illimitato; la partita e il risultato salvati restano disponibili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration des achats utilise votre compte Apple. Le remboursement d’un achat supprime l’accès illimité ; votre partie et votre résultat enregistrés restent accessibles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar compras usa a sua Conta Apple. O reembolso de uma compra retira o acesso ilimitado; a partida e o resultado guardados continuam disponíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar compras usa sua Conta Apple. O reembolso de uma compra remove o acesso ilimitado; a partida e o resultado salvos continuam disponíveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen herstellen gebruikt je Apple Account. Bij terugbetaling vervalt onbeperkte toegang. Je opgeslagen wedstrijd en resultaat blijven beschikbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe werden über deinen Apple Account wiederhergestellt. Bei einer Erstattung entfällt die unbegrenzte Freischaltung. Deine gespeicherte Partie und das Ergebnis bleiben zugänglich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ köp använder ditt Apple-konto. Om köpet återbetalas upphör den obegränsade åtkomsten. Ditt sparade spel och resultat är fortfarande tillgängliga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan køb bruger din Apple-konto. Hvis et køb refunderes, bortfalder den ubegrænsede adgang. Din gemte kamp og dit resultat er stadig tilgængelige."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostojen palauttaminen käyttää Apple-tiliäsi. Oston hyvittäminen poistaa rajattoman käyttöoikeuden. Tallennettu peli ja tulos ovat edelleen käytettävissä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprett kjøp bruker Apple-kontoen din. Refusjon fjerner den ubegrensede tilgangen. Det lagrede spillet og resultatet er fortsatt tilgjengelig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для восстановления используется ваш Аккаунт Apple. Возврат средств снимает доступ без ограничений; сохранённая игра и результат остаются доступны."
          }
        }
      }
    },
