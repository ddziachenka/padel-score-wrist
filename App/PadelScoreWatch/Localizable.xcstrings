    "These games already win the set. Correct them, or add the set under Sets.": {
      "comment": "Correction: the current set's games chosen would already have decided the set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These games already win the set. Correct them, or add the set under Sets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos juegos, el set ya estaría ganado. Corrígelos o añade el set en Sets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questi game il set è già vinto. Correggili o aggiungi il set nella sezione Set."
