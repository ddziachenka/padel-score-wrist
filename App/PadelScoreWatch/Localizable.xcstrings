    "Advantage isn’t used with Golden point. Change the rule or correct the score.": {
      "comment": "Correction: a team has AD while the 40–40 rule is Golden point, which plays no advantage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advantage isn’t used with Golden point. Change the rule or correct the score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto de oro no admite ventaja. Cambia la regla o corrige el marcador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il punto de oro non si giocano i vantaggi. Cambia la regola o correggi il punteggio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle du point décisif n’utilise pas l’avantage. Changez de règle ou corrigez le score."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se usa vantagem com ponto de ouro. Altere a regra ou corrija a pontuação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se usa vantagem com ponto de ouro. Altere a regra ou corrija o placar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Golden point wordt zonder voordeel gespeeld. Pas de regel of de score aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Golden Point gibt es keinen Vorteil. Ändere die Regel oder korrigiere den Spielstand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fördel används inte med Golden point. Byt regel eller rätta ställningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der spilles uden fordel ved Golden point. Skift reglen, eller ret stillingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratkaisevan pisteen säännössä ei käytetä etua. Vaihda sääntöä tai korjaa pistetilanne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordel brukes ikke med golden point. Endre regelen eller rett stillingen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При золотом очке преимущества нет. Измените правило или исправьте счёт."
          }
        }
      }
    },
