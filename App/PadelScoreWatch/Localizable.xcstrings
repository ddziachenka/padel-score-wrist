    "Apple handles purchases and restoration. Game data isn’t sent to our servers.": {
      "comment": "Access and purchase: Apple handles purchases and restoration. Game data isn’t sent to our servers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple handles purchases and restoration. Game data isn’t sent to our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestiona las compras y su restauración. Los datos de las partidas no se envían a nuestros servidores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestisce acquisti e ripristino. I dati di gioco non vengono inviati ai nostri server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gère les achats et leur restauration. Les données de jeu ne sont pas envoyées à nos serveurs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple trata das compras e do restauro. Os dados das partidas não são enviados para os nossos servidores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple trata das compras e da restauração. Os dados das partidas não são enviados para os nossos servidores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple regelt aankopen en het herstellen ervan. Wedstrijdgegevens worden niet naar onze servers verstuurd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wickelt Käufe und deren Wiederherstellung ab. Partiedaten werden nicht an unsere Server gesendet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hanterar köp och återställning av köp. Speldata skickas inte till våra servrar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple håndterer køb og gendannelse. Kampdata sendes ikke til vores servere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hoitaa ostot ja niiden palauttamisen. Pelitietoja ei lähetetä palvelimillemme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple håndterer kjøp og gjenoppretting. Spilldata sendes ikke til serverne våre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки и их восстановление обрабатывает Apple. Игровые данные на наши серверы не передаются."
          }
        }
      }
    },
