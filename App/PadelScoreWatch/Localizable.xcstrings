    "It was saved by a newer version of this app. Update the app, then try again.": {
      "comment": "Recovery: the saved game comes from a newer version of the app, which this version does not overwrite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was saved by a newer version of this app. Update the app, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardó con una versión más reciente de la app. Actualízala e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio proviene da una versione più recente dell’app. Aggiorna l’app e riprova."
