    "A set ends at six games with a lead of two, at 7–5 or at 7–6.": {
      "comment": "Correction of a completed set: its games are not a score that ends a set. The scores 7–5 and 7–6 are kept on one line with word joiners around the dash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A set ends at six games with a lead of two, at 7⁠–⁠5 or at 7⁠–⁠6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El set termina con seis juegos y dos de ventaja, con 7⁠–⁠5 o con 7⁠–⁠6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un set termina a sei game con due di vantaggio, sul 7⁠–⁠5 o sul 7⁠–⁠6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un set se termine à six jeux avec deux jeux d’écart, à 7⁠–⁠5 ou à 7⁠–⁠6."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um set termina aos seis jogos com dois de diferença, a 7–5 ou a 7–6."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um set termina em seis games com dois de diferença, em 7–5 ou em 7–6."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een set eindigt bij zes games met twee games verschil, bij 7⁠–⁠5 of bij 7⁠–⁠6."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Satz endet bei sechs Spielen mit zwei Spielen Vorsprung, bei 7–5 oder bei 7–6."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett set slutar vid sex game med två games marginal, vid 7–5 eller vid 7–6."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et sæt slutter ved seks partier med to partiers forspring, ved 7⁠–⁠5 eller 7⁠–⁠6."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erä päättyy kuuteen peliin kahden pelin erolla tai lukemiin 7–5 tai 7–6."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et sett avsluttes ved seks game med to game i ledelse, ved 7⁠–⁠5 eller ved 7⁠–⁠6."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сет завершается при шести геймах с отрывом в два, при 7⁠–⁠5 или 7⁠–⁠6."
          }
        }
      }
    },
