    "Served in a row by one player, whoever wins.": {
      "comment": "Explains rallies per server under its number: the serve passes after this many rallies.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Served in a row by one player, whoever wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saca un mismo jugador de forma consecutiva, gane quien gane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Battuti di seguito dallo stesso giocatore, a prescindere da chi vince il punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis à la suite par le même joueur, quelle que soit l’équipe qui marque."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidos consecutivamente pelo mesmo jogador, independentemente de quem ganha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacados consecutivamente pelo mesmo jogador, independentemente de quem ganha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén speler serveert deze rally’s achter elkaar, ongeacht wie het punt wint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viele Ballwechsel schlägt ein Spieler hintereinander auf, unabhängig davon, wer punktet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servas i följd av samma spelare, oavsett vem som vinner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme spiller server alle dueller i serien, uanset hvem der vinder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama pelaaja syöttää peräkkäin riippumatta pisteiden voittajasta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én spiller server disse på rad, uansett hvem som vinner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один игрок подаёт подряд независимо от того, кто выигрывает очки."
          }
        }
      }
    },
    "Serves the tie-break’s first point; then each player serves two.": {
