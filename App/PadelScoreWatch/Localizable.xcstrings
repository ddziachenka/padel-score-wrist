{
  "sourceLanguage": "en",
  "strings": {
    "From your watch face, turn the Digital Crown up to open the Smart Stack. Touch and hold, tap +, then choose Padel Score. Tap Done.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your watch face, turn the Digital Crown up to open the Smart Stack. Touch and hold, tap +, then choose Padel Score. Tap Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la esfera, gira la Digital Crown hacia arriba para abrir el Grupo inteligente. Mantén pulsado, toca + y elige Padel Score. Toca Listo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal quadrante, ruota la Digital Crown verso l’alto per aprire Raccolta smart. Tieni premuto, tocca + e scegli Padel Score. Tocca Fine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis le cadran, tournez la Digital Crown vers le haut pour ouvrir la pile intelligente. Maintenez le doigt sur l’écran, touchez +, puis choisissez Padel Score. Touchez OK."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No mostrador, rode a Digital Crown para cima para abrir a Pilha inteligente. Toque sem levantar o dedo, toque em + e escolha Padel Score. Toque em OK."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No mostrador, gire a Digital Crown para cima para abrir o Conjunto Inteligente. Mantenha o dedo na tela, toque em + e escolha Padel Score. Toque em OK."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai op de wijzerplaat de Digital Crown omhoog om de slimme stapel te openen. Houd ingedrukt, tik op + en kies Padel Score. Tik op Gereed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe auf dem Zifferblatt die Digital Crown nach oben, um den Smart-Stapel zu öffnen. Halte ihn gedrückt, tippe auf + und wähle Padel Score. Tippe auf „Fertig“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid Digital Crown uppåt från urtavlan för att öppna Smart trave. Håll fingret på skärmen, tryck på + och välj Padel Score. Tryck på Klar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej Digital Crown opad fra urskiven for at åbne Smart stak. Hold fingeren nede, tryk på +, og vælg Padel Score. Tryk på OK."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa älykäs pino kääntämällä Digital Crownia ylöspäin kellotaulussa. Pidä näyttöä painettuna, napauta + ja valitse Padel Score. Napauta Valmis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri Digital Crown opp fra urskiven for å åpne Smart stabel. Trykk og hold, trykk på + og velg Padel Score. Trykk på Ferdig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На циферблате прокрутите Digital Crown вверх, чтобы открыть Смарт-стопку. Нажмите и удерживайте экран, коснитесь + и выберите Padel Score. Нажмите «Готово»."
          }
        }
      }
    },
