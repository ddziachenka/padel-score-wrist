    "More rallies have been played than the total. Increase the total or correct the score.": {
      "comment": "Correction of an americano round: the two teams' points add up to more than the total rallies.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More rallies have been played than the total. Increase the total or correct the score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han jugado más puntos que el total. Aumenta el total o corrige el marcador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punti giocati superano il totale. Aumenta il totale o correggi il punteggio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de points joués dépasse le total prévu. Augmentez le total ou corrigez le score."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram disputados mais pontos do que o total. Aumente o total ou corrija a pontuação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram disputados mais pontos do que o total. Aumente o total ou corrija o placar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn meer rally’s gespeeld dan het totaal. Verhoog het totaal of pas de score aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind mehr Ballwechsel gespielt als insgesamt vorgesehen. Erhöhe die Gesamtzahl oder korrigiere den Spielstand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler bollar har spelats än det totala antalet. Höj totalantalet eller rätta ställningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er spillet flere dueller end det samlede antal. Øg antallet, eller ret stillingen."
          }
        },
        "fi": {
          "stringUnit": {
