          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare. I dati di gioco sono invariati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppression impossible. Vos données de jeu n’ont pas changé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar. Os dados das partidas não foram alterados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar. Os dados das partidas não foram alterados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissen mislukt. Je wedstrijdgegevens zijn ongewijzigd."
          }
        },
        "de": {
