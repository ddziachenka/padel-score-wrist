    "You can leave this screen. A completed purchase will still unlock access.": {
      "comment": "Access and purchase: You can leave this screen. A completed purchase will still unlock access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave this screen. A completed purchase will still unlock access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes salir de esta pantalla. Si se completa la compra, el acceso se activará igualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi uscire da questa schermata. Se l’acquisto viene completato, l’accesso verrà comunque sbloccato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez quitter cet écran. L’accès sera débloqué dès que l’achat sera finalisé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode sair deste ecrã. Se a compra for concluída, o acesso será desbloqueado na mesma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode sair desta tela. Se a compra for concluída, o acesso será desbloqueado mesmo assim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit scherm verlaten. Zodra de aankoop is voltooid, krijg je toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Bildschirm verlassen. Sobald der Kauf abgeschlossen ist, wird der Zugriff trotzdem freigeschaltet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lämna den här skärmen. Åtkomsten låses upp när köpet har slutförts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan forlade denne skærm. Adgangen låses stadig op, når købet er gennemført."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit poistua tästä näkymästä. Valmis osto avaa käyttöoikeuden silti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan forlate denne skjermen. Tilgangen låses opp når kjøpet er fullført."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно закрыть этот экран. После завершения покупки доступ всё равно откроется."
          }
        }
      }
    },
    "Your current game and last result stay available, even without a purchase.": {
      "comment": "Access and purchase: Your current game and last result stay available, even without a purchase.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current game and last result stay available, even without a purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida actual y el último resultado siguen disponibles, aunque no compres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La partita in corso e l’ultimo risultato restano disponibili anche senza acquistare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre partie en cours et votre dernier résultat restent accessibles, même sans achat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A partida atual e o último resultado continuam disponíveis, mesmo sem comprar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partida atual e o último resultado continuam disponíveis, mesmo sem comprar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige wedstrijd en laatste resultaat blijven ook zonder aankoop beschikbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine laufende Partie und das letzte Ergebnis bleiben auch ohne Kauf zugänglich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt pågående spel och senaste resultat är tillgängliga även utan köp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din igangværende kamp og det seneste resultat er tilgængelige, også uden køb."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyinen peli ja viimeisin tulos ovat käytettävissä myös ilman ostoa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillet du spiller og det nyeste resultatet er tilgjengelig selv uten kjøp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая игра и последний результат доступны даже без покупки."
          }
        }
      }
    },
    "Your current score will be saved.": {
      "comment": "Finish match or Finish round: under the question, what Finish does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current score will be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardará el marcador actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio attuale verrà salvato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre score actuel sera enregistré."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontuação atual será guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontuação atual será salva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige score wordt opgeslagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Spielstand wird gespeichert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nuvarande ställning sparas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nuværende stilling bliver gemt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyinen pistetilanne tallennetaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingen du har nå, blir lagret."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий счёт сохранится."
          }
        }
      }
    },
    "Your free-game count couldn’t be recovered. Restore a purchase or unlock to start a new game.": {
      "comment": "Access: the free-game count was lost with damaged data, so a new game needs a purchase. Access says separately that the game and result stay available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free-game count couldn’t be recovered. Restore a purchase or unlock to start a new game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido recuperar el número de partidas gratuitas. Restaura una compra o activa el acceso para iniciar una nueva partida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare il conteggio delle partite gratuite. Ripristina un acquisto o sblocca l’accesso per iniziare una nuova partita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer votre compteur de parties gratuites. Restaurez un achat ou débloquez l’accès pour commencer une nouvelle partie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar a contagem de partidas gratuitas. Restaure uma compra ou desbloqueie o acesso para iniciar uma nova partida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar a contagem de partidas gratuitas. Restaure uma compra ou desbloqueie o acesso para iniciar uma nova partida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je teller voor gratis wedstrijden kon niet worden hersteld. Herstel een aankoop of koop toegang om een nieuwe wedstrijd te starten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zähler kostenloser Partien konnte nicht wiederhergestellt werden. Stelle einen Kauf wieder her oder schalte die App frei, um eine neue Partie zu starten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antalet gratisspel kunde inte återställas. Återställ ett köp eller köp åtkomst för att starta ett nytt spel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af gratis kampe kunne ikke gendannes. Gendan et køb, eller lås op for at starte en ny kamp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaispelien määrää ei voitu palauttaa. Palauta osto tai osta käyttöoikeus aloittaaksesi uuden pelin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenopprette antall gratisspill. Gjenopprett et kjøp eller lås opp tilgangen for å starte et nytt spill."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить счётчик бесплатных игр. Чтобы начать новую игру, восстановите покупку или откройте доступ."
          }
        }
      }
    },
    "Your free-game count couldn’t be recovered. Restore a purchase or unlock to start a new game. Your current game stays available.": {
      "comment": "Access and purchase: Your free-game count couldn’t be recovered. Restore a purchase or unlock to start a new game. Your current game stays available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free-game count couldn’t be recovered. Restore a purchase or unlock to start a new game. Your current game stays available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido recuperar el número de partidas gratuitas. Restaura una compra o activa el acceso para iniciar una nueva partida. Tu partida actual sigue disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare il conteggio delle partite gratuite. Ripristina un acquisto o sblocca l’accesso per iniziare una nuova partita. La partita in corso resta disponibile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer votre compteur de parties gratuites. Restaurez un achat ou débloquez l’accès pour commencer une nouvelle partie. Votre partie en cours reste accessible."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar a contagem de partidas gratuitas. Restaure uma compra ou desbloqueie o acesso para iniciar uma nova partida. A partida atual continua disponível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar a contagem de partidas gratuitas. Restaure uma compra ou desbloqueie o acesso para iniciar uma nova partida. A partida atual continua disponível."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je teller voor gratis wedstrijden kon niet worden hersteld. Herstel een aankoop of koop toegang om een nieuwe wedstrijd te starten. Je huidige wedstrijd blijft beschikbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zähler kostenloser Partien konnte nicht wiederhergestellt werden. Stelle einen Kauf wieder her oder schalte die App frei, um eine neue Partie zu starten. Deine laufende Partie bleibt zugänglich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antalet gratisspel kunde inte återställas. Återställ ett köp eller köp åtkomst för att starta ett nytt spel. Ditt pågående spel är fortfarande tillgängligt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af gratis kampe kunne ikke gendannes. Gendan et køb, eller lås op for at starte en ny kamp. Din igangværende kamp er stadig tilgængelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaispelien määrää ei voitu palauttaa. Palauta osto tai osta käyttöoikeus aloittaaksesi uuden pelin. Nykyinen peli on edelleen käytettävissä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenopprette antall gratisspill. Gjenopprett et kjøp eller lås opp tilgangen for å starte et nytt spill. Spillet du spiller er fortsatt tilgjengelig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить счётчик бесплатных игр. Чтобы начать новую игру, восстановите покупку или откройте доступ. Текущая игра остаётся доступной."
          }
        }
      }
    },
    "Your game and free-game count are stored on this Watch. Deleting game data keeps the count. Reinstalling the app or changing Watches may lose local data.": {
      "comment": "Access and purchase: Your game and free-game count are stored on this Watch. Deleting game data keeps the count. Reinstalling the app or changing Watches may lose local data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game and free-game count are stored on this Watch. Deleting game data keeps the count. Reinstalling the app or changing Watches may lose local data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida y el número de partidas gratuitas se guardan en este Watch. Al eliminar los datos de las partidas, se conserva el contador. Si reinstalas la app o cambias de Watch, puedes perder los datos locales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La partita e il conteggio delle partite gratuite sono salvati su questo Watch. Eliminare i dati di gioco non azzera il conteggio. Reinstallando l’app o cambiando Watch potresti perdere i dati locali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre partie et votre compteur de parties gratuites sont stockés sur cette Watch. Supprimer les données de jeu conserve le compteur. Une réinstallation de l’app ou un changement de Watch peut entraîner la perte des données locales."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A partida e a contagem de partidas gratuitas ficam guardadas neste Apple Watch. Apagar os dados das partidas mantém a contagem. Reinstalar a app ou mudar de Apple Watch pode causar a perda de dados locais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partida e a contagem de partidas gratuitas ficam salvas neste Apple Watch. Apagar os dados das partidas mantém a contagem. Reinstalar o app ou trocar de Apple Watch pode causar a perda de dados locais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wedstrijd en teller voor gratis wedstrijden worden op deze Watch bewaard. Ook na het wissen van wedstrijdgegevens blijft de teller bewaard. Bij herinstallatie van de app of een andere Watch kunnen lokale gegevens verloren gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Partie und der Zähler kostenloser Partien sind auf dieser Watch gespeichert. Beim Löschen der Partiedaten bleibt der Zähler erhalten. Bei einer Neuinstallation oder einem Wechsel der Watch können lokale Daten verloren gehen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt spel och antalet gratisspel sparas på den här klockan. Antalet behålls när du raderar speldata. Lokala data kan gå förlorade om du installerar om appen eller byter klocka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din kamp og antallet af gratis kampe gemmes på dette ur. Antallet bevares, når du sletter kampdata. Lokale data kan gå tabt, hvis du geninstallerer appen eller skifter ur."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peli ja käytettyjen ilmaispelien määrä tallennetaan tähän kelloon. Pelitietojen poistaminen säilyttää määrän. Sovelluksen asentaminen uudelleen tai kellon vaihtaminen voi johtaa paikallisten tietojen menettämiseen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillet og antallet gratisspill lagres på denne klokken. Antallet beholdes når du sletter spilldata. Lokale data kan gå tapt hvis du installerer appen på nytt eller bytter klokke."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра и счётчик бесплатных игр хранятся на этих часах. Удаление данных игры сохраняет счётчик. При переустановке приложения или смене часов локальные данные могут быть потеряны."
          }
        }
      }
    },
    "Your last saved score is unchanged.": {
      "comment": "Game screen, under Couldn’t save.: the score shown is the one last saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last saved score is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último marcador guardado sigue igual."
          }
        },
        "it": {
          "stringUnit": {
