    "Five completed games are free. A one-time lifetime purchase unlocks unlimited new games. The App Store confirms the price before you buy.": {
      "comment": "Access and purchase: Five completed games are free. A one-time lifetime purchase unlocks unlimited new games. The App Store confirms the price before you buy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five completed games are free. A one-time lifetime purchase unlocks unlimited new games. The App Store confirms the price before you buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las primeras cinco partidas completadas son gratis. Una única compra da acceso de por vida a partidas sin límite. El App Store confirma el precio antes de comprar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque partite completate sono gratuite. Un solo acquisto dà accesso illimitato a nuove partite, per sempre. L’App Store conferma il prezzo prima dell’acquisto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq parties terminées sont gratuites. Un achat unique donne accès à un nombre illimité de nouvelles parties, à vie. L’App Store confirme le prix avant l’achat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco partidas terminadas são gratuitas. Uma única compra vitalícia desbloqueia partidas ilimitadas. A App Store confirma o preço antes da compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco partidas terminadas são gratuitas. Uma única compra vitalícia desbloqueia partidas ilimitadas. A App Store confirma o preço antes da compra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf voltooide wedstrijden zijn gratis. Met één aankoop kun je levenslang onbeperkt nieuwe wedstrijden starten. De App Store bevestigt de prijs voordat je koopt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf abgeschlossene Partien sind kostenlos. Mit einem einmaligen Kauf schaltest du unbegrenzt neue Partien dauerhaft frei. Der App Store zeigt dir den Preis vor dem Kauf."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem avslutade spel är gratis. Ett engångsköp ger permanent åtkomst till obegränsat antal nya spel. App Store visar priset innan du köper."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem afsluttede kampe er gratis. Et engangskøb giver ubegrænset adgang til nye kampe. App Store bekræfter prisen, før du køber."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viisi päättynyttä peliä on ilmaisia. Kertaostolla saat pysyvän käyttöoikeuden ja rajattomasti uusia pelejä. App Store vahvistaa hinnan ennen ostoa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem fullførte spill er gratis. Et engangskjøp gir varig tilgang til ubegrenset antall nye spill. App Store viser prisen før du kjøper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые пять завершённых игр бесплатны. Разовая покупка навсегда снимает ограничение на новые игры. Перед покупкой App Store подтвердит цену."
          }
        }
      }
    },
