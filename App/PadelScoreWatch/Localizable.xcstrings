        }
      }
    },
    "This removes your game, last result and saved settings from this Watch. Your free-game count and purchase are kept.": {
      "comment": "Access and purchase: This removes your game, last result and saved settings from this Watch. Your free-game count and purchase are kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your game, last result and saved settings from this Watch. Your free-game count and purchase are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de este Watch tu partida, el último resultado y los ajustes guardados. Se conservarán el número de partidas gratuitas y tu compra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina da questo Watch la partita, l’ultimo risultato e le impostazioni salvate. Il conteggio delle partite gratuite e l’acquisto vengono conservati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime votre partie, le dernier résultat et les réglages enregistrés de cette Watch. Votre compteur de parties gratuites et votre achat sont conservés."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga a partida, o último resultado e as definições guardadas neste Apple Watch. Mantém a contagem de partidas gratuitas e a compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga a partida, o último resultado e os ajustes salvos neste Apple Watch. A contagem de partidas gratuitas e a compra são mantidas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wis je je wedstrijd, laatste resultaat en opgeslagen instellingen van deze Watch. Je teller voor gratis wedstrijden en je aankoop blijven bewaard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden deine Partie, das letzte Ergebnis und gespeicherte Einstellungen von dieser Watch gelöscht. Der Zähler kostenloser Partien und dein Kauf bleiben erhalten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort ditt spel, senaste resultat och sparade inställningar från den här klockan. Antalet gratisspel och ditt köp behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner din kamp, det seneste resultat og gemte indstillinger fra dette ur. Antallet af gratis kampe og dit køb bevares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pelin, viimeisimmän tuloksen ja tallennetut asetukset tästä kellosta. Käytettyjen ilmaispelien määrä ja osto säilyvät."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner spillet, det nyeste resultatet og lagrede innstillinger fra denne klokken. Antall gratisspill og kjøpet beholdes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра, последний результат и сохранённые настройки будут удалены с этих часов. Счётчик бесплатных игр и покупка сохранятся."
          }
        }
      }
    },
