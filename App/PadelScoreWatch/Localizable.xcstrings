    "Apple’s Standard End User License Agreement applies. Its public address is shown below; these product details do not replace that license.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’s Standard End User License Agreement applies. Its public address is shown below; these product details do not replace that license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica el contrato de licencia estándar de Apple para el usuario final. Su dirección pública aparece más abajo; estos detalles del producto no sustituyen esa licencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica il contratto di licenza standard di Apple per l’utente finale. Il relativo indirizzo pubblico è indicato qui sotto; questi dettagli sul prodotto non sostituiscono la licenza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrat de licence standard d’Apple s’applique. Son adresse publique figure ci-dessous ; les présentes informations sur le produit ne remplacent pas cette licence."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se o Contrato de Licença de Utilizador Final padrão da Apple. O endereço público encontra-se abaixo; estas informações sobre o produto não substituem essa licença."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se o Contrato de Licença de Usuário Final padrão da Apple. O endereço público encontra-se abaixo; estas informações sobre o produto não substituem essa licença."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaardlicentieovereenkomst voor eindgebruikers van Apple is van toepassing. Het webadres staat hieronder. Deze productinformatie vervangt die licentie niet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gilt die Standard-Endnutzer-Lizenzvereinbarung von Apple. Die öffentliche Adresse findest du unten. Diese Produktinformationen ersetzen die Lizenzvereinbarung nicht."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples standardlicensavtal för slutanvändare gäller. Webbadressen visas nedan. Dessa produktuppgifter ersätter inte licensavtalet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples standardlicensaftale for slutbrugere gælder. Den offentlige adresse vises nedenfor. Disse produktoplysninger erstatter ikke licensaftalen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellukseen sovelletaan Applen vakiomuotoista loppukäyttäjän lisenssisopimusta. Sen verkko-osoite on alla. Nämä tuotetiedot eivät korvaa lisenssisopimusta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples standard lisensavtale for sluttbrukere gjelder. Nettadressen vises nedenfor. Disse produktopplysningene erstatter ikke lisensavtalen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует стандартное лицензионное соглашение Apple с конечным пользователем. Ссылка на него приведена ниже; эти сведения о продукте не заменяют лицензию."
          }
        }
      }
    },
