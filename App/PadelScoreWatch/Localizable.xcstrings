            "state": "translated",
            "value": "Deze waarden kunnen niet samen voorkomen. Controleer de score en de service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte passen nicht zusammen. Prüfe den Spielstand und den Aufschlag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här värdena går inte att kombinera. Kontrollera ställningen och serveordningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse værdier kan ikke forekomme sammen. Kontrollér stilling og serv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä arvot eivät muodosta mahdollista pelitilannetta. Tarkista pisteet ja syötöt."
          }
        },
        "nb": {
