      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which rally of their block the next server serves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué punto de su turno sacará el siguiente sacador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale punto della propria serie batterà il prossimo battitore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rang du prochain point dans la série de services de ce joueur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual dos pontos do bloco será servido pelo próximo jogador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual dos pontos do bloco será sacado pelo próximo jogador."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De positie van de volgende rally binnen de servicebeurt van die speler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An welcher Stelle im Aufschlagblock der nächste Ballwechsel liegt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken boll i serveserien nästa servare står inför."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeringen af næste duel i spillerens serveserie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavan pallon numero syöttäjän omassa vuorossa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken ballveksling i serveserien den neste serveren skal serve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер следующего розыгрыша в серии текущего подающего."
          }
        }
      }
    },
